# Copy to .env and change passwords for your own machine.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=vector_rag
MARIADB_USER=rag_user
MARIADB_PASSWORD=rag-dev-password
MARIADB_ROOT_PASSWORD=root-dev-password

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
# all-MiniLM-L6-v2 only reads the first 256 word pieces (~190 words) of a
# chunk, so keep chunks small. Changing these re-chunks articles on next ingest.
CHUNK_WORDS=160
CHUNK_OVERLAP=30
MIN_CHUNK_WORDS=30

# Contact info sent in the Wikipedia User-Agent (Wikimedia policy). Use your
# university email or the repository URL.
WIKI_CONTACT=https://github.com/ma7920810-cmd/mariadb-vector-rag
WIKI_REQUEST_DELAY=0.5
